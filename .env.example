# Copy this file to .env and fill in your values. Never commit .env: it holds credentials.
#
# The server authenticates with AFAS OAuth 2.0: every user logs in at AFAS (authorization code flow
# with PKCE). The first five variables are required.

# The number in your AFAS Online URL, e.g. https://12345.afasonline.com -> 12345
AFAS_MEMBER_ID=12345

# The AFAS app connector with authentication type OAuth (confidential client, authorization code
# flow). Its redirect URL must be {AFAS_PUBLIC_URL}/oauth/afas/callback.
AFAS_OAUTH_CLIENT_ID=YOUR_CLIENT_ID
AFAS_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET

# The https URL users reach this server on, without a trailing slash.
AFAS_PUBLIC_URL=https://afas-mcp.example.com

# Encrypts the stored AFAS tokens; changing it logs everyone out. Generate your own with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AFAS_ENCRYPTION_KEY=GENERATE_YOUR_OWN

# --- Optional ------------------------------------------------------------------------------------
# production (default), test or accept. Selects rest / resttest / restaccept in the hostname.
AFAS_ENVIRONMENT=production

# SQLite file with registered MCP clients and the encrypted AFAS tokens. The Docker image sets this
# to /data/afas-mcp-server.sqlite3 itself; only set it when you run the server without Docker.
# AFAS_DATABASE_PATH=afas-mcp-server.sqlite3

# Full REST base URL. Overrides AFAS_MEMBER_ID and AFAS_ENVIRONMENT, e.g. for a proxy. Must be https.
# AFAS_BASE_URL=https://12345.rest.afas.online/profitrestservices

# Register the insert, update and delete tools. Off by default: the server is read-only.
AFAS_ALLOW_WRITES=false

# HTTP timeout per AFAS call, in seconds.
AFAS_TIMEOUT_SECONDS=60

# Rows per page when a tool call does not give a take, and the largest take a tool call may request.
AFAS_DEFAULT_TAKE=100
AFAS_MAX_TAKE=1000

# Language of AFAS messages and of the login pages: nl-nl, nl-be, fr-fr, de-de or en-us.
AFAS_LANGUAGE=nl-nl

# DEBUG, INFO, WARNING, ERROR or CRITICAL. Logs go to stderr.
AFAS_LOG_LEVEL=INFO
